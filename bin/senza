#!/bin/sh
# Senza CLI launcher (repo checkout, ~/.local/bin symlink, or inside Senza.app/Contents/Resources).
# Resolves its real location, picks a Python 3.9+ and runs the `senza` package that sits next to it.
self="$0"
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case "$link" in
        /*) self="$link" ;;
        *) self="$(dirname "$self")/$link" ;;
    esac
done
root=$(cd "$(dirname "$self")/.." && pwd -P)

for py in "${SENZA_PYTHON:-}" /opt/homebrew/bin/python3 /usr/local/bin/python3 python3 /usr/bin/python3; do
    [ -n "$py" ] || continue
    command -v "$py" >/dev/null 2>&1 || continue
    if "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then
        # Put this install first on sys.path (`-m` would let a `senza/` dir in the cwd shadow it).
        SENZA_ROOT="$root" exec "$py" -c 'import os, sys; sys.path.insert(0, os.environ["SENZA_ROOT"]); sys.argv[0] = "senza"; from senza.cli import main; sys.exit(main())' "$@"
    fi
done

echo "senza: Python 3.9 or newer not found. Install the Xcode Command Line Tools: xcode-select --install" >&2
exit 127
